{
  "name": "namanh-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm --prefix client install && npm --prefix client run build",
    "deploy": "npm run build && npx wrangler pages deploy client/dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
